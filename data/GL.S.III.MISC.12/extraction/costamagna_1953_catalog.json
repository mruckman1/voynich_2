  "word_formation": {
    "source_images": [
      "GL_S_III_MISC_12_11.jpg",
      "GL_S_III_MISC_12_12.jpg"
    ],
    "pages": [
      13,
      14
    ],
    "basic_principle": "Words are formed by writing the simple succession of syllabic notes representing individual syllables.",
    "examples": [
      {
        "word": "consoprino",
        "syllables": [
          "con",
          "so",
          "pri",
          "no"
        ]
      },
      {
        "word": "bonifiedus",
        "syllables": [
          "bo",
          "ni",
          "fre",
          "dus"
        ]
      }
    ],
    "sigla": {
      "description": "For frequently recurring words, the graphic elements lose their letter value and take on a representative one, standing alone for the entire word. These are mostly grammatical determiners (pronouns, auxiliaries) and relational words (prepositions, conjunctions). True sigla are rare in syllabic tachygraphy; the few found are borrowed from the Tironian system.",
      "tironian_sigla": [
        "atque",
        "super",
        "supra",
        "est",
        "qui",
        "que",
        "quod",
        "etc."
      ]
    },
    "prefixes": {
      "description": "Syllabic tachygraphy made extensive use of particular notes representing prefixes. Graphically these have all the prerogatives and characteristics of sigla for isolated words.",
      "notes": "See plates for specific prefix signs"
    },
    "abbreviations": {
      "description": "Very rarely abbreviations are used, obtained mostly by suppressing some entire intermediate syllable in the word.",
      "examples": [
        {
          "abbreviation": "mo-ne-rio",
          "full_word": "monesterio"
        },
        {
          "abbreviation": "di",
          "full_word": "dicitur",
          "notes": "Sometimes very common words represented by initial letter or syllable alone"
        }
      ]
    }
  },
