  "combination_rules": {
    "source_images": [
      "GL_S_III_MISC_12_06.jpg",
      "GL_S_III_MISC_12_07.jpg",
      "GL_S_III_MISC_12_08.jpg",
      "GL_S_III_MISC_12_09.jpg",
      "GL_S_III_MISC_12_10.jpg"
    ],
    "pages": [
      8,
      9,
      10,
      11,
      12
    ],
    "sign_connection_methods": [
      {
        "method": "simple_union",
        "description": "Second sign drawn immediately after the first",
        "page": 8,
        "examples": [
          "tr",
          "cl",
          "pl",
          "fl",
          "fr",
          "pr"
        ]
      },
      {
        "method": "fusion",
        "description": "Part of one sign absorbed into the preceding or following sign",
        "page": 8,
        "examples": [
          "sa",
          "ta",
          "ma",
          "co",
          "au",
          "pau"
        ]
      },
      {
        "method": "crossing",
        "description": "Sign crosses one of the preceding signs",
        "page": 8,
        "examples": [
          "cit",
          "rit"
        ]
      },
      {
        "method": "intermediate_stroke_or_loop",
        "description": "Signs joined with an intermediate stroke or loop (occhiello)",
        "page": 8,
        "examples": [
          "ris",
          "stris"
        ]
      }
    ],
    "open_syllables": {
      "description": "Open syllables (beginning or ending with a vowel) are formed by simple union or fusion of signs, sometimes with the vowel implied. Vowel signs are well recognizable. Open syllables opening to the left often fall among the prefixes.",
      "page": 9,
      "examples": [
        "al",
        "au",
        "be",
        "bo",
        "ce",
        "da",
        "me",
        "mo",
        "fo",
        "fu",
        "pe",
        "po"
      ]
    },
    "closed_syllables_and_compound_consonants": {
      "description": "In closed syllables, vocalic signs are connected to consonant signs in the ways previously indicated. Compound consonants (from union of two consonants, essentially l-n-r-s preceded or followed by other consonants) follow the same rules.",
      "pages": [
        9,
        10
      ],
      "closed_syllable_examples": [
        "bar",
        "cal",
        "dul",
        "mer",
        "mul",
        "nul",
        "dal",
        "ful",
        "mal",
        "uual",
        "gel",
        "bel"
      ],
      "compound_consonant_examples": [
        "bri",
        "cle",
        "dre",
        "fro",
        "gna",
        "fre",
        "pli",
        "tra",
        "tri",
        "tre",
        "tres",
        "dri"
      ]
    },
    "diphthongs": {
      "description": "Diphthongs are represented with simple alphabetic indication; exceptions are oe and ae, represented with simple e.",
      "page": 10
    },
    "syllable_final_consonants": {
      "description": "The indication of syllable-final consonants m, n, r, s, t is of particular interest.",
      "pages": [
        11,
        12
      ],
      "rules": [
        {
          "consonant": "m",
          "indicator": "two_dots",
          "description": "Final m indicated by two dots placed after/above the vowel sign",
          "examples": [
            "bem",
            "cam"
          ]
        },
        {
          "consonant": "n",
          "indicator": "one_dot",
          "description": "Final n indicated by a single dot",
          "examples": [
            "can",
            "fun",
            "lan"
          ]
        },
        {
          "consonant": "r",
          "indicator_after_a": "vertical_descender",
          "description_after_a": "After vowel a: vertical downward extension of the vowel sign",
          "examples_after_a": [
            "bar",
            "car",
            "mar"
          ],
          "indicator_after_other_vowels": "dot_right",
          "description_after_other_vowels": "After other vowels: a dot to the right",
          "examples_after_other_vowels": [
            "uir",
            "tur"
          ]
        },
        {
          "consonant": "s",
          "indicator_after_a_e_o_u": "downward_curve_left",
          "description_after_a_e_o_u": "After a, e, o, u: downward extension curving left from the vowel sign",
          "examples_after_a_e_o_u": [
            "cas",
            "dos"
          ],
          "indicator_after_i": "oblique_stroke_upper_left",
          "description_after_i": "After i: an oblique stroke upward to the left",
          "examples_after_i": [
            "sis"
          ]
        },
        {
          "consonant": "t",
          "indicator": "crossbar",
          "description": "A horizontal or vertical stroke, superscribed, subscribed, or crossing the preceding sign",
          "examples": [
            "sunt",
            "stat",
            "rit"
          ]
        }
      ]
    }
  },
